# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Amplitude (analytics)
# NEXT_PUBLIC_AMPLITUDE_API_KEY é opcional — só para inicializar SDK no client (não contém segredo)
# AMPLITUDE_API_KEY é obrigatório no servidor (use em Vercel/Railway como secret)
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-public-amplitude-key
AMPLITUDE_API_KEY=your-secret-amplitude-key

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...

# Comissão (padrão: 10%, mínimo R$5)
PAYMENT_FEE_PERCENT=0.10
PAYMENT_MIN_FEE_CENTS=500
